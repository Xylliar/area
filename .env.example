# Optional settings for docker compose: copy this file to .env and fill in what you need.
# Everything works without it; integrations whose keys are missing just report an error when used.

# Database credentials
# POSTGRES_USER=area
# POSTGRES_PASSWORD=area
# POSTGRES_DB=area_db

# Public URLs of the application server and of the web client
# SERVER_URL=http://localhost:8080
# WEB_CLIENT_URL=http://localhost:8081

# Signs the session tokens. A random key is generated at startup when unset,
# which logs everyone out on every restart of the server.
# SECRET_KEY=

# Emails: account activation, password reset and the Resend reaction.
# Without a key, the activation and reset links are printed in `docker compose logs server`.
# RESEND_API_KEY=
# EMAIL_FROM=AREA <onboarding@resend.dev>

# OAuth applications (login with Google/GitHub, linking of the services).
# Callback URL to register on each provider: <SERVER_URL>/auth/<provider>/callback
# (Google: <SERVER_URL>/auth/google/callback/login and <SERVER_URL>/auth/google/callback/link).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Public URL at which GitHub can reach the github microservice (e.g. an ngrok tunnel to it),
# required by the GitHub webhook actions.
# GITHUB_WEBHOOK_URL=

# API keys of the microservices
# BRAWLSTARS_API_KEY=
# OPENWEATHER_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
