# Only used when running the server outside Docker (docker-compose reads the root .env instead).
# Every variable is optional: leave a line commented out to keep its default.

# DATABASE_URL=postgresql://area:area@localhost:5432/area_db
# SERVER_URL=http://localhost:8080
# WEB_CLIENT_URL=http://localhost:8081

# Signs the session tokens. A random key is generated at startup when unset.
# SECRET_KEY=

# Where the server reaches the microservices, "{service}" being the service key of services_catalog.yaml.
# SERVICE_URL_TEMPLATE=http://{service}-service:8000

# Emails (account activation, password reset). Without a key, the links are printed in the server logs.
# RESEND_API_KEY=
# EMAIL_FROM=AREA <onboarding@resend.dev>

# OAuth applications. A provider stays disabled until both its id and secret are set.
# Callback URL to register on each provider: <SERVER_URL>/auth/<provider>/callback
# (Google uses /auth/google/callback/login and /auth/google/callback/link).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
